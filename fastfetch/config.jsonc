{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "data",
        "source": "\n\u001b[1;34mJ\u001b[0m\n\u001b[1;34mE\u001b[0m\n\u001b[1;34mS\u001b[0m\n\u001b[1;34mU\u001b[0m\n\u001b[1;34mS\u001b[0m\n\u001b[1;34m\u001b[1m\u001b[22m\u001b[1m☦\u001b[0m\n\u001b[1;34m",
        "padding": {
            "top": 1,
            "left": 4,
            "right": 5
        }
    },
    "display": {
        "separator": "  "
    },
    "modules": [
        {
            "key": "{#35}╭─ {#31} user   ",
            "type": "title",
            "format": "{user-name}"
        },
        {
            "key": "{#35}├─ {#32} display",
            "type": "display",
            "compactType": "original-with-refresh-rate"
        },
        {
            "key": "{#35}├─ {#33}󰅐 uptime ",
            "type": "uptime"
        },
        {
            "key": "{#35}├─ {#33}󰁼 battery",
            "type": "battery",
	    	"percent": {"type": 1}
        },
        {
             "key": "{#35}├─ {#33}󱐌 profile",
             "type": "command",
       	     "text": "tlp-stat -m "
        },
		{
            "key": "{#35}├─ {#34}󱦟 install",
            "type": "command",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "key": "{#35}├─ {#35} kernel ",
            "type": "kernel"
        },
        {
            "key": "{#35}├─ {#33}󰍛 cpu    ",
            "type": "cpu",
            "showPeCoreCount": true
        },
        {
            "key": "{#35}├─ {#31}󰢮 gpu    ",
            "type": "gpu",
            "format": "{2}"
        },
        {
            "key": "{#35}╰─ {#34}󰉉 disk   ",
            "type": "disk",
            "folders": "/"
        }
    ]
}
